{
  "openapi": "3.0.0",
  "info": {
    "title": "VMH GROUP • Vendors API Documentation",
    "version": "1.0.0",
    "description": "Official API documentation and integration specifications for VMH Group API Tool Partners and Vendors. Use these REST endpoints to fetch assigned surveys in real time, obtain dynamic respondent entry links, inspect targeting qualifications, and process automated S2S postback callbacks."
  },
  "servers": [
    {
      "url": "https://api.vmhgroupsmr.com",
      "description": "Production API Tool Gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "access-key",
        "description": "Enter your Partner API Key. You can also provide `?vendor_id=YOUR_VENDOR_CODE` in query parameters."
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/supplier/getAllSurveys": {
      "get": {
        "summary": "Get all assigned surveys for vendor",
        "description": "Retrieves all active market research surveys allocated to the authenticated vendor. Contains CPI, LOI, incidence rate, remaining quota, and dynamic entry links.",
        "tags": [
          "Vendor Inventory"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "vendor_id",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Your vendor code (e.g. VND-AFC01 or VI1793895852). Required if access-key header is omitted.",
            "example": "VND-AFC01"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved allocated surveys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllSurveysResponse"
                },
                "example": {
                  "success": true,
                  "apiVersion": 1,
                  "message": "Active surveys retrieved successfully",
                  "result": {
                    "success": true,
                    "vendor_id": "VND-AFC01",
                    "total": 3,
                    "data": [
                      {
                        "survey_id": "2141504327",
                        "survey_name": "Consumer Tech Study",
                        "cpi": 1.20,
                        "loi": "13",
                        "ir": "74",
                        "total_quota": 656,
                        "remaining_quota": 656,
                        "country": "US",
                        "language": "en-US",
                        "live_url": "https://api.vmhgroupsmr.com/vendor/auth/VND-AFC01/project/2141504327?uid=[RESPONDENT_ID]"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid access key"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/supplier/getSurveyDetails": {
      "get": {
        "summary": "Get detailed study info & qualifications",
        "description": "Retrieves comprehensive details for a specific survey including targeting criteria, quotas, and qualification questions.",
        "tags": [
          "Vendor Inventory"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "survey_id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique survey / study ID",
            "example": "2141504327"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved survey details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SurveyDetailsResponse"
                },
                "example": {
                  "success": true,
                  "apiVersion": 1,
                  "message": "Survey details retrieved successfully",
                  "result": {
                    "success": true,
                    "data": {
                      "survey_id": "2141504327",
                      "name": "Consumer Tech Study",
                      "cpi": 1.20,
                      "loi": "13",
                      "ir": "74",
                      "status": "Live",
                      "quota_limit": 656,
                      "country": "US",
                      "language": "en-US",
                      "entry_link": "https://api.vmhgroupsmr.com/vendor/auth/VND-AFC01/project/2141504327?uid=[RESPONDENT_ID]",
                      "qualifications": [
                        {
                          "name": "AGE",
                          "operator": "between",
                          "value": "18-99"
                        },
                        {
                          "name": "COUNTRY",
                          "operator": "equals",
                          "value": "US"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - survey_id is required"
          },
          "404": {
            "description": "Survey not found"
          }
        }
      }
    },
    "/api/supplier/getSurveyStats": {
      "get": {
        "summary": "Get real-time study statistics",
        "description": "Retrieves traffic and conversion statistics for a specific survey (entrances, completes, terminates, overquota).",
        "tags": [
          "Performance & Stats"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "survey_id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Survey ID to inspect",
            "example": "2141504327"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved survey statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SurveyStatsResponse"
                },
                "example": {
                  "success": true,
                  "apiVersion": 1,
                  "result": {
                    "success": true,
                    "data": {
                      "survey_id": "2141504327",
                      "total_clicks": 142,
                      "completes": 38,
                      "terminates": 82,
                      "overquota": 12,
                      "conversion_rate": "26.8%"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - survey_id is required"
          }
        }
      }
    },
    "/api/supplier/getDefinitions": {
      "get": {
        "summary": "Get system definitions & languages",
        "description": "Retrieves standard definitions including supported ISO country codes and language definitions.",
        "tags": [
          "Metadata & Definitions"
        ],
        "responses": {
          "200": {
            "description": "Definitions retrieved successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "apiVersion": 1,
                  "message": "Definitions retrieved successfully",
                  "result": {
                    "success": true,
                    "data": {
                      "languages": [
                        { "id": 1, "country_code": "US", "language": "en-US", "language_name": "English" },
                        { "id": 2, "country_code": "GB", "language": "en-GB", "language_name": "English" },
                        { "id": 3, "country_code": "IN", "language": "hi-IN", "language_name": "Hindi" }
                      ],
                      "countries": [
                        { "id": 1, "country_code": "US", "country_name": "United States" },
                        { "id": 2, "country_code": "IN", "country_name": "India" }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/supplier/getQualifications": {
      "get": {
        "summary": "Get demographic qualification schema",
        "description": "Retrieves qualification questions and answer options for standard screening.",
        "tags": [
          "Metadata & Definitions"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "lang_id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Language ID from getDefinitions (e.g. 1 for en-US)",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Qualifications schema retrieved successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AllSurveysResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "apiVersion": { "type": "integer" },
          "message": { "type": "string" },
          "result": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "vendor_id": { "type": "string" },
              "total": { "type": "integer" },
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SurveyItem"
                }
              }
            }
          }
        }
      },
      "SurveyItem": {
        "type": "object",
        "properties": {
          "survey_id": { "type": "string" },
          "survey_name": { "type": "string" },
          "cpi": { "type": "number", "format": "float" },
          "loi": { "type": "string", "description": "Length of interview in minutes" },
          "ir": { "type": "string", "description": "Incidence rate percentage" },
          "total_quota": { "type": "integer" },
          "remaining_quota": { "type": "integer" },
          "country": { "type": "string" },
          "language": { "type": "string" },
          "live_url": { "type": "string", "description": "Entry URL containing [RESPONDENT_ID] placeholder" }
        }
      },
      "SurveyDetailsResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "result": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "data": {
                "type": "object",
                "properties": {
                  "survey_id": { "type": "string" },
                  "name": { "type": "string" },
                  "cpi": { "type": "number" },
                  "loi": { "type": "string" },
                  "ir": { "type": "string" },
                  "status": { "type": "string" },
                  "quota_limit": { "type": "integer" },
                  "entry_link": { "type": "string" },
                  "qualifications": {
                    "type": "array",
                    "items": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      },
      "SurveyStatsResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "result": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "data": {
                "type": "object",
                "properties": {
                  "survey_id": { "type": "string" },
                  "total_clicks": { "type": "integer" },
                  "completes": { "type": "integer" },
                  "terminates": { "type": "integer" },
                  "overquota": { "type": "integer" },
                  "conversion_rate": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
