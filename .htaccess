<IfModule mod_rewrite.c>
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>
RewriteEngine On
RewriteBase /

# 1. Existing files and directories served directly
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Universal PHP router & SPA fallback
RewriteRule ^ index.php [QSA,L]
</IfModule>
